# Copy to .env.mac on the MacBook.
STUDYBUDDY_API=http://192.168.8.2:8000
STUDYBUDDY_BRIDGE_TOKEN=change-this-on-demo-day
STUDYBUDDY_CDP_URL=http://127.0.0.1:9222

# Default: Browser-Use -> StudyBuddy authenticated proxy -> Spartan Teacher on Spark.
# It runs DOM/text mode so the same resident 32B model can serve tutoring and resource scouting.
STUDYBUDDY_BROWSER_PROVIDER=vllm-proxy
STUDYBUDDY_BROWSER_MODEL=spartan-teacher
STUDYBUDDY_BROWSER_FLASH_MODE=1
STUDYBUDDY_BROWSER_USE_VISION=0
STUDYBUDDY_BROWSER_MAX_STEPS=25

# Optional dedicated Browser-Use VLM profile: start scripts/models/start_browser.sh on Spark
# and point the StudyBuddy proxy/model config at it. Do not assume it fits beside a dense 32B model.
# STUDYBUDDY_BROWSER_MODEL=browser-use/bu-30b-a3b-preview
# STUDYBUDDY_BROWSER_USE_VISION=1

# Alternative native Browser-Use Ollama mode.
# STUDYBUDDY_BROWSER_PROVIDER=ollama
# STUDYBUDDY_OLLAMA_URL=http://192.168.8.2:11434
# STUDYBUDDY_OLLAMA_MODEL=qwen3:8b
