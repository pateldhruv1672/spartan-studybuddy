{
  "uid": "spartan-studybuddy",
  "title": "Spartan StudyBuddy \u2014 DGX Spark",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "StudyBuddy requests / min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(studybuddy_model_requests_total[1m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tutor p95 latency",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(studybuddy_model_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tutor p95 TTFT",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(studybuddy_model_ttft_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tutor avg output TPS",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(studybuddy_model_output_tokens_per_second_sum[5m])) / clamp_min(sum(rate(studybuddy_model_output_tokens_per_second_count[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "StudyBuddy output TPS by route",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(studybuddy_model_output_tokens_per_second_sum[5m])) by (route) / clamp_min(sum(rate(studybuddy_model_output_tokens_per_second_count[5m])) by (route), 0.001)",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request latency p50 / p95",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(studybuddy_model_latency_seconds_bucket[5m])) by (le, route))",
          "refId": "A",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(studybuddy_model_latency_seconds_bucket[5m])) by (le, route))",
          "refId": "B",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "vLLM running / waiting",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm:num_requests_running",
          "refId": "A",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "vLLM KV-cache usage",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "vLLM TTFT p95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[5m])) by (le, job))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Agent jobs / min",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(studybuddy_agent_jobs_total[1m])) by (kind, status) * 60",
          "refId": "A",
          "legendFormat": "{{kind}} {{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Competition telemetry",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "### Spartan StudyBuddy engineering evidence\nThis dashboard is sourced from local Prometheus metrics. Use it during the demo to show TTFT, throughput, queueing, KV-cache use, and agent activity. Raw prompts/traces stay in the local StudyBuddy trace store; Tempo receives OpenTelemetry spans when enabled."
      }
    }
  ]
}