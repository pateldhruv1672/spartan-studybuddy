# =========================================
# Spartan StudyBuddy for Teams / DGX Spark
# =========================================
STUDYBUDDY_HOST=0.0.0.0
STUDYBUDDY_PORT=8000
STUDYBUDDY_DATA_DIR=./data

# PostgreSQL + pgvector (the only persistence/RAG database)
POSTGRES_DB=studybuddy
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=studybuddy
POSTGRES_PORT=5432
PGVECTOR_IMAGE=pgvector/pgvector:0.8.6-pg16
DATABASE_URL=postgresql://studybuddy:studybuddy@127.0.0.1:5432/studybuddy
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
STUDYBUDDY_DEMO_USER=demo-spartan
STUDYBUDDY_DEMO_ORG=demo-company
STUDYBUDDY_API_TOKEN=spartan-local
STUDYBUDDY_BRIDGE_TOKEN=change-this-on-demo-day
MODEL_TIMEOUT_S=240
MAX_UPLOAD_MB=500

# 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 

# DGX Spark: Docker-first vLLM runtime.
VLLM_RUNTIME=docker
VLLM_IMAGE=vllm/vllm-openai:latest
# HF_TOKEN=hf_...
VLLM_API_KEY=local-edge
VLLM_ENABLE_THINKING_ROUTING=1

# =========================
# Main tutor / reasoning LLM
# =========================
# Competition model: large dense Qwen3, then LoRA fine-tuned for Socratic software tutoring.
SOCRATIC_BASE_MODEL=Qwen/Qwen3-32B
SOCRATIC_MERGED_DIR=./artifacts/socratic-merged
USE_TUNED_SOCRATIC_MODEL=1
GENERAL_SERVED_MODEL_NAME=spartan-teacher
VLLM_INSTRUCT_URL=http://127.0.0.1:8101/v1
VLLM_INSTRUCT_MODEL=spartan-teacher
VLLM_REASONING_URL=http://127.0.0.1:8101/v1
VLLM_REASONING_MODEL=spartan-teacher
GENERAL_GPU_UTIL=0.72
GENERAL_MAX_MODEL_LEN=32768
GENERAL_MAX_NUM_SEQS=8
GENERAL_MAX_BATCHED_TOKENS=8192

# =================================
# Embeddings / hybrid code-aware RAG
# =================================
EMBEDDING_URL=http://127.0.0.1:8105/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_BATCH=24
# Keep 0 in real deployments so the pgvector index cannot mix incompatible embedding spaces.
ALLOW_EMBEDDING_FALLBACK=0
EMBEDDING_GPU_UTIL=0.055
EMBEDDING_MAX_MODEL_LEN=8192
RETRIEVAL_TOP_K=12

# ==========================================
# Browser-Use: reuse the 32B model by default
# ==========================================
BROWSER_LLM_PROVIDER=vllm
VLLM_BROWSER_URL=http://127.0.0.1:8101/v1
VLLM_BROWSER_MODEL=spartan-teacher
# Optional dedicated browser VLM. Starting another 30B model simultaneously is NOT the default.
DEDICATED_BROWSER_MODEL=browser-use/bu-30b-a3b-preview
BROWSER_PORT=8104
BROWSER_GPU_UTIL=0.58
BROWSER_MAX_MODEL_LEN=32768
BROWSER_MAX_NUM_SEQS=2
OLLAMA_BROWSER_URL=http://127.0.0.1:11434/v1
OLLAMA_BROWSER_MODEL=qwen3:8b

# =====================
# Private source access
# =====================
# GITHUB_TOKEN=github_pat_...
# GOOGLE_DRIVE_ACCESS_TOKEN=ya29....   # only needed for private Drive folders/files

# ====================
# Fine-tuning defaults
# ====================
TRAINING_BACKEND=llamafactory
SOCRATIC_EPOCHS=1
SOCRATIC_MAX_STEPS=300
SOCRATIC_LR=0.0001
SOCRATIC_LORA_R=32
SOCRATIC_LORA_ALPHA=64
SOCRATIC_MAX_LENGTH=3072
SOCRATIC_GRAD_ACCUM=8
# Set -1 for epoch-based training after the pipeline is proven.
# SOCRATIC_MAX_STEPS=-1

# ====================
# Speculative decoding
# ====================
# none | ngram | eagle3. `make benchmark` writes the measured recommendation.
SPECULATION_METHOD=none
NGRAM_SPEC_TOKENS=5
NGRAM_PROMPT_LOOKUP_MAX=4
EAGLE3_SPECULATOR_MODEL=RedHatAI/Qwen3-32B-speculator.eagle3
EAGLE3_SPEC_TOKENS=3
TRY_EAGLE3=1

# =============
# Observability
# =============
TELEMETRY_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=spartan-studybuddy
GRAFANA_USER=admin
GRAFANA_PASSWORD=studybuddy
# Optional cloud exporter. Keep blank for private deployments.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spartan-studybuddy

# Keep autonomous desktop actions off unless explicitly enabled.
ENABLE_AGENT_ACTIONS=0
